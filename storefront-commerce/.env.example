# OpenRouter API key (https://openrouter.ai/keys) — powers the shopping assistant
OPENROUTER_API_KEY=
# Optional OpenRouter model slug; must be one of DEMO_MODELS in lib/ai/models.ts,
# otherwise the default (anthropic/claude-sonnet-5) is used
OPENROUTER_MODEL=

# Sentry DSN (Project Settings > Client Keys); public var so the browser SDK sees it too
NEXT_PUBLIC_SENTRY_DSN=
# Sentry org and project slugs — used by the build for source map upload
SENTRY_ORG=
SENTRY_PROJECT=
# Optional auth token; when unset, source map upload is skipped and builds still pass
SENTRY_AUTH_TOKEN=

# Prompts, system instructions, and tool arguments on gen_ai spans. Unset = true,
# so the demo shows full conversations; set to false to keep content off spans.
SENTRY_AI_RECORD_INPUTS=true
# Model output and tool results on gen_ai spans. Unset = true. The build mirrors
# both into NEXT_PUBLIC_ copies so the browser SDK honours the same setting.
SENTRY_AI_RECORD_OUTPUTS=true

# Storefront branding shown in the layout metadata and footer
COMPANY_NAME="Acme, Inc."
SITE_NAME="Acme Store"
