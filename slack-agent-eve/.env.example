# OpenRouter API key — read by @openrouter/ai-sdk-provider in agent/agent.ts
# and by the estimate_nutrition tool's own model call
OPENROUTER_API_KEY=
# Sentry project DSN (Settings > Client Keys) — read by Sentry.init in agent/instrumentation.ts
SENTRY_DSN=
# Optional Sentry knobs (defaults shown) — see agent/instrumentation.ts
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1
# SENTRY_ENABLE_LOGS=true
# SENTRY_RECORD_INPUTS=true    # gen_ai prompt/content capture (dataCollection.genAI.inputs + eve recordInputs)
# SENTRY_RECORD_OUTPUTS=true   # gen_ai completion capture (dataCollection.genAI.outputs + eve recordOutputs)
# Slack bot token (xoxb-…) — env fallback used by slackChannel() in agent/channels/slack.ts
SLACK_BOT_TOKEN=
# Slack app signing secret — verifies webhooks Slack sends to /eve/v1/slack
SLACK_SIGNING_SECRET=
# Budget per person per meal in USD — enforced in add_to_cart. A group order's
# own per-person spend limit wins over this when the host set one. (default 25)
MEAL_BUDGET_USD=25
# Model for the estimate_nutrition tool's structured call (OpenRouter slug)
NUTRITION_MODEL=anthropic/claude-haiku-4.5
# Path to the dd-cli binary if it isn't on PATH (defaults to "dd-cli")
# DD_CLI_BIN=
