# OpenRouter API key — read by @openrouter/ai-sdk-provider in agent/agent.ts
# and by the estimate_nutrition tool's own model call
OPENROUTER_API_KEY=
# Sentry project DSN (Settings > Client Keys) — read by Sentry.init in agent/instrumentation.ts
SENTRY_DSN=
# Slack bot token (xoxb-…) — env fallback used by slackChannel() in agent/channels/slack.ts
SLACK_BOT_TOKEN=
# Slack app signing secret — verifies webhooks Slack sends to /eve/v1/slack
SLACK_SIGNING_SECRET=
# Per-person lunch budget in USD — enforced in add_to_group_cart (default 25)
LUNCH_BUDGET_USD=25
# Model for the estimate_nutrition tool's structured call (OpenRouter slug)
NUTRITION_MODEL=anthropic/claude-haiku-4.5
# Path to the dd-cli binary if it isn't on PATH (defaults to "dd-cli")
# DD_CLI_BIN=
