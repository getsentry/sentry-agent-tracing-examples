# OpenRouter API key — read by @openrouter/ai-sdk-provider in agent/agent.ts
# and by the estimate_nutrition tool's own model call
OPENROUTER_API_KEY=
# Sentry project DSN (Settings > Client Keys) — read by Sentry.init in agent/instrumentation.ts
SENTRY_DSN=
# Optional Sentry knobs (defaults shown) — see agent/instrumentation.ts
# SENTRY_ENVIRONMENT=development
# Version this deploy reports, so issues attribute to a release and regressions
# are detectable. Falls back to VERCEL_GIT_COMMIT_SHA when unset.
# SENTRY_RELEASE=
# SENTRY_TRACES_SAMPLE_RATE=1
# SENTRY_ENABLE_LOGS=true
# SENTRY_AI_RECORD_INPUTS=true    # gen_ai prompt/content capture (dataCollection.genAI.inputs + eve recordInputs)
# SENTRY_AI_RECORD_OUTPUTS=true   # gen_ai completion capture (dataCollection.genAI.outputs + eve recordOutputs)
# Slack bot token (xoxb-…) — env fallback used by slackChannel() in agent/channels/slack.ts
SLACK_BOT_TOKEN=
# Slack app signing secret — verifies webhooks Slack sends to /eve/v1/slack
SLACK_SIGNING_SECRET=
# Budget per person per meal in USD — enforced in add_to_cart. A group order's
# own per-person spend limit wins over this when the host set one. (default 25)
MEAL_BUDGET_USD=25
# Model for the estimate_nutrition tool's structured call (OpenRouter slug)
NUTRITION_MODEL=openai/gpt-5.6-luna
# Path to the dd-cli binary if it isn't on PATH (defaults to "dd-cli")
# DD_CLI_BIN=
# dd-cli access token from `dd-cli export-token`. Required only where the CLI
# runs in a Vercel Sandbox (deployments); expires after a few days.
# DD_CLI_ACCESS_TOKEN=
# Force the sandbox path on (1) or off (0). Unset means: sandbox when VERCEL is
# set, local binary otherwise. See runsInSandbox in agent/lib/dd.ts.
# DD_CLI_SANDBOX=
