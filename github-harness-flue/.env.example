# OpenRouter API key — every model call (lead agent and both subagents) routes through OpenRouter.
OPENROUTER_API_KEY=

# Sentry DSN of the project that receives traces, logs, and issues. Empty = Sentry disabled, agent still runs.
SENTRY_DSN=

# Trace sample rate 0–1. Must be > 0 or no agent/model/tool spans are produced (0 = errors + logs only).
SENTRY_TRACES_SAMPLE_RATE=1

# Sentry environment tag, e.g. development or ci.
SENTRY_ENVIRONMENT=development

# Optional release tag on every event, e.g. a commit SHA (the CI workflow sets it to github.sha).
SENTRY_RELEASE=

# "true" records prompts, system instructions, and tool arguments on spans (off is the privacy-safe default).
SENTRY_AI_RECORD_INPUTS=true

# "true" records model output and tool results on spans (off is the privacy-safe default).
SENTRY_AI_RECORD_OUTPUTS=true

# Sentry API token for the review agent's MCP connection (issue search + resolve).
# Needs org:read, project:read, event:read, event:write. Empty = Sentry impact step disabled.
SENTRY_ACCESS_TOKEN=

# Org and project whose OPEN ISSUES the reviewer checks the diff against (the app's
# project — not the agent-telemetry project above). Both must be set to enable the step.
SENTRY_ORG_SLUG=
SENTRY_APP_PROJECT_SLUG=

# "true" posts the review as a PR comment via the GitHub API; unset/false writes review.md to disk instead.
POST_TO_GITHUB=false

# Token with pull-request write access. GitHub Actions injects its own GITHUB_TOKEN — only set this locally.
GITHUB_TOKEN=

# owner/repo of the pull request, e.g. your-org/your-repo (set automatically inside GitHub Actions).
GITHUB_REPOSITORY=

# Number of the pull request to comment on.
PR_NUMBER=
